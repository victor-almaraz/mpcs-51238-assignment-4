{
  "name": "cadmium",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "demo": "CADMIUM_DEMO=1 NEXT_PUBLIC_CADMIUM_DEMO=1 next dev --port 3100",
    "screens": "node --import tsx scripts/screens.ts",
    "audit:ui": "node --import tsx scripts/audit-ui.ts",
    "build": "next build",
    "start": "next start",
    "gen": "node --import tsx scripts/gen-bundle.ts",
    "gen:check": "node --import tsx scripts/gen-bundle.ts && git diff --exit-code -- lib/bundle/schemas.generated.ts lib/bundle/types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm gen:check && pnpm typecheck && pnpm lint --max-warnings 0 && pnpm test && pnpm build",
    "materials": "node --import tsx lib/materials/cli.ts",
    "harness": "node --import tsx lib/harness/cli.ts",
    "golden": "node --import tsx scripts/golden.ts",
    "eval:parser": "node --env-file-if-exists=.env.local --import tsx scripts/eval-parser.ts",
    "bundles": "node --import tsx scripts/bundles.ts",
    "sim": "node --import tsx tools/sim/cli.ts",
    "db:fresh": "node --import tsx scripts/db-fresh.ts",
    "agent:run": "node --env-file-if-exists=.env.local --import tsx scripts/agent-run.ts"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.19",
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^1.61.0",
    "monaco-editor": "~0.55.1",
    "monaco-yaml": "^5.5.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
