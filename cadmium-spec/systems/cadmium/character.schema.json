{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.dungeon-crawler.invalid/v1/systems/cadmium/character.schema.json",
  "title": "Cadmium character sheet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "role": {
      "enum": [
        "fighter",
        "invoker",
        "ranger",
        "naturalist",
        "doctor",
        "spy",
        "magician",
        "wizard"
      ]
    },
    "hp": {
      "$ref": "#/$defs/meter"
    },
    "ap": {
      "type": "integer",
      "minimum": 0,
      "description": "Adventure Points. No maximum; spent AP does not recharge."
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      },
      "description": "Limit enforced by can_carry: 12, raised by the stash module."
    },
    "status": {
      "enum": [
        "active",
        "deaths_door",
        "dead"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "armor": {
      "$ref": "#/$defs/meter",
      "description": "Module armor: the armor pool. Default { value: 0, max: modules.armor.max }."
    }
  },
  "required": [
    "name",
    "role",
    "hp",
    "ap",
    "abilities",
    "inventory",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "meter": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "value",
        "max"
      ],
      "additionalProperties": false
    }
  },
  "description": "Fields marked with a module are accepted only when that module is enabled."
}
