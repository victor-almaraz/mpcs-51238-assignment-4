{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.dungeon-crawler.invalid/v1/npc.schema.json",
  "title": "Adventure NPC",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "defs.schema.json#/$defs/label"
    },
    "template": {
      "$ref": "defs.schema.json#/$defs/ref"
    },
    "art": {
      "$ref": "defs.schema.json#/$defs/art"
    },
    "disposition": {
      "enum": [
        "friendly",
        "neutral",
        "wary",
        "hostile"
      ]
    },
    "topics": {
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "defs.schema.json#/$defs/label"
          },
          "when": {
            "$ref": "defs.schema.json#/$defs/requirement"
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "effects": {
            "$ref": "defs.schema.json#/$defs/adventure_effects"
          }
        },
        "required": [
          "label",
          "brief"
        ],
        "additionalProperties": false
      }
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "id",
    "name",
    "template"
  ],
  "additionalProperties": false
}
